<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Android 11+: the games must be listed to be visible to this app. -->
    <queries>
        <package android:name="jp.co.fanzagames.muvluv_ggx_app" />
        <package android:name="jp.co.fanzagames.muvluv_ggx_app.en" />
        <package android:name="com.dmm.dmmgames.muvluv_gg_app" />
        <package android:name="com.dmm.dmmgames.muvluv_gg_app.en" />
    </queries>

    <application
        android:label="GGX EN Patcher"
        android:icon="@android:drawable/sym_def_app_icon"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".InstallReceiver" android:exported="false" />
    </application>
</manifest>
